(rule
 (targets test.ml test.mli)
 (deps    test.atd)
 (action  (run %{bin:atdgen-extra} %{deps})))

(alias
 (name runtest)
 (package atdgen-extra)
 (action (diff test.expected.ml test.ml)))

(alias
 (name runtest)
 (package atdgen-extra)
 (action (diff test.expected.mli test.mli)))

