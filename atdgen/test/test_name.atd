type sum_poly = [
  | A <name name="a">
  | B <name name="bb">
  | C <name name="Ccc">
]

type sum_classic = [
  | A <name name="a">
  | B <name name="bb">
  | C <name name="Ccc">
] <ocaml repr="classic">

type sum_args_poly = [
  | A <name name="a"> of int
  | B <name name="bb"> of string
  | C <name name="Ccc"> of sum_poly
  | D <name name="d!"> of sum_args_poly
  | E <name name="E"> of (float * unit)
  | F <name name="">
]

type sum_args_classic = [
  | A <name name="a"> of int
  | B <name name="bb"> of string
  | C <name name="Ccc"> of sum_classic
  | D <name name="d!"> of sum_args_classic
  | E <name name="E"> of (float * unit)
  | F <name name="">
]

type sum_open_enum_poly = [
  | A <name name="a">
  | B <name name="bb">
  | C <name name="Ccc">
  | Z <name name="Z"> of string
] <name open_enum>

type sum_open_enum_classic = [
  | A <name name="a">
  | B <name name="bb">
  | C <name name="Ccc">
  | Z <name name="Z"> of string
] <ocaml repr="classic"> <name open_enum>

type wrap_string = string wrap <ocaml t="string" wrap="Fun.id" unwrap="Fun.id">

type plain_string = string
